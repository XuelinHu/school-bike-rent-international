PORT=8032
JWT_SECRET=replace_with_a_long_random_secret

# PostgreSQL connection. Keep real credentials in the ignored backend/.env file.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=student_bike_rental_app
# 这里只放占位符。真实密码写在 backend/.env（已被 .gitignore 忽略），不要提交。
PGPASSWORD=replace_with_your_postgresql_password
PGDATABASE=student_bike_rental
PGPOOL_MAX=10
PGSSL=0
OIDC_ISSUER=https://192.168.1.9:8042/realms/front
OIDC_CLIENT_ID=school-bike-rent-web
# For the LAN development issuer, set NODE_EXTRA_CA_CERTS to the private CA certificate.
DB_BACKUP_ENCRYPTION_KEY=
ALLOW_DEMO_SEED=0
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_STAFF_PASSWORD=
SMOKE_USERNAME=student
SMOKE_PASSWORD=
SMOKE_ADMIN_USERNAME=admin
SMOKE_ADMIN_PASSWORD=
BASE_URL=

# ─────────────── 智能助手 ───────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_DEFAULT_MODEL=ollama:qwen3:14b
AI_MAX_TOOL_ROUNDS=3
# 本机 Ollama 单槽串行，并发闸门设 1；第二个请求排队而不是一起卡住
AI_MAX_CONCURRENCY=1
AI_KEEP_ALIVE=10m

# ⚠️ AI_NUM_CTX **不是采样参数，而是加载参数**。发一个与常驻实例不同的值，
# Ollama 会把整个模型卸载再重载 KV cache；这台机器的显卡是多个项目共用的，
# 显存不够时这个重载**永远完不成**（心跳照发，第一个 token 永远不来）。
# **0 = 根本不发这个参数**，直接复用常驻实例，是这台机器上唯一安全的选项。
# 只有独占显卡时才填具体值（如 8192）。
AI_NUM_CTX=0

# 等模型加载完的上限（毫秒）。Ollama 在模型进显存前一个字节都不发响应头，
# 所以冷加载时间全算在这里面 —— 实测同机有其它项目占显存时出现过 110 秒。
AI_REQUEST_TIMEOUT_MS=180000

# ─────────────── 云模型（配了 key 才会出现在下拉里）───────────────
# 留空即不启用该厂商，前端下拉会自动少一组，不会报错。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-chat

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODELS=qwen-plus,qwen-turbo

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=gpt-4o-mini
