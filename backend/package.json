{
  "name": "student-bike-rental-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node scripts/integration-test.js",
    "smoke": "node scripts/smoke-test.js",
    "test:concurrency": "node scripts/concurrency-test.js",
    "test:load": "node scripts/load-test.js",
    "db:init": "node src/utils/initDb.js",
    "db:backup": "node --env-file-if-exists=.env scripts/pg-backup.mjs backup",
    "db:restore": "node --env-file-if-exists=.env scripts/pg-backup.mjs restore",
    "seed": "node src/utils/seedUsers.js",
    "seed:demo": "node src/utils/seedDemoData.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
